    },
    {
      "event": "hurt",
      "id": "varga_hurt_1",
      "phrase": false,
      "text": "Ugh!"
    },
    {
      "event": "hurt",
      "id": "varga_hurt_2",
      "phrase": false,
      "text": "Ah!"
    },
    {
      "event": "broken",
      "id": "varga_broken_1",
      "phrase": false,
      "text": "Hah... hah..."
    },
    {
      "event": "intro_1",
      "id": "varga_intro_1",
      "phrase": true,
      "text": "Stop there. That smoke is not a village burning. It's their clothes. The sick ones."
    },
    {
      "event": "intro_2",
      "id": "varga_intro_2",
      "phrase": true,
      "text": "And did he tell you why his wagons are in such a hurry to cross a closed pass?"
    },
    {
      "event": "intro_3",
      "id": "varga_intro_3",
      "phrase": true,
      "text": "Then come. I hope you live long enough to regret them."
    },
    {
      "event": "phase",
      "id": "varga_phase_1",
      "phrase": true,
      "text": "Not yet. Look at the smoke, soldier. Ask yourself what we are burning."
    },
    {
      "event": "death",
      "id": "varga_death_1",
      "phrase": true,
      "text": "He told you we burned villages? Look at the smoke... look at what we burn."
    },
    {
      "event": "victory",
      "id": "varga_victory_1",
      "phrase": true,
      "text": "Stay down. You don't know what you're doing."
    },
    {
      "event": "victory",
      "id": "varga_victory_2",
      "phrase": true,
      "text": "Go home. Tell him the Pass is closed."
    }
