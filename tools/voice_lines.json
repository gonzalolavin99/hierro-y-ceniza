  "varga": [
    {
      "event": "spot",
      "id": "varga_spot_1",
      "phrase": true,
      "text": "So the Regent finally sent his hound. Draw, then."
    },
    {
      "event": "spot",
      "id": "varga_spot_2",
      "phrase": true,
      "text": "You're far from the capital, soldier. You should have stayed there."
    },
    {
      "event": "attack",
      "id": "varga_attack_1",
      "phrase": false,
      "text": "Hah!"
    },
    {
